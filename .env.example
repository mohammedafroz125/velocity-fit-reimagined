# ==============================================================================
# Velocity Fit — Environment Variables Specification (.env.example)
# Note: Never commit real keys, tokens, or credentials into source control.
# ==============================================================================

# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Private Service Role (Server-Side ONLY — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin & Notification Settings
ADMIN_EMAIL_NOTIFICATION_RECIPIENT=velocityfit55@gmail.com
EMAIL_PROVIDER_API_KEY=

# Optional Rate Limiting / Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay Gateway Configuration (Phase 2B Payments)
# Key ID is safe for browser bundle
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Key Secret and Webhook Secret are strictly server-side only
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Calendar Provider Configuration (Phase 2B Consultations)
# Options: 'mock' (default IST fallback), 'google', 'calcom'
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
